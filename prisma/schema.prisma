datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique
  products Product[]
}

model Attribute {
  id          Int    @id @default(autoincrement())
  name        String @unique
  values      String @db.Text
  controlType String @default("dropdown")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  src       String
  name      String?
  alt       String?
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Product {
  id                Int            @id @default(autoincrement())
  name              String
  nameEn            String?
  slug              String         @unique
  permalink         String?
  price             String
  regularPrice      String?
  salePrice         String?
  onSale            Boolean        @default(false)
  shortDescription  String?        @db.Text
  shortDescriptionEn String?       @db.Text
  description       String?        @db.Text
  descriptionEn      String?        @db.Text
  stock             Int            @default(0)
  productType       String         @default("simple") // simple or variable
  status            String         @default("publish") // publish or draft
  seoScore          Int            @default(0)
  metaTitle         String?
  metaTitleEn       String?
  metaDescription   String?        @db.Text
  metaDescriptionEn String?        @db.Text
  dateCreated       DateTime       @default(now())
  categories        Category[]
  images            ProductImage[]
  attributes        String?        @db.Text
  reviews           Review[]
  showInSensoryCompass Boolean      @default(false)
  sensoryNoiseLevel String?
  sensorySize       String?
  sensoryCategory   String?
  sensoryProfiles   String?
}

model BlogPost {
  id                Int      @id @default(autoincrement())
  title             String
  slug              String   @unique
  content           String   @db.Text
  excerpt           String?  @db.Text
  date              DateTime @default(now())
  status            String   @default("publish")
  featuredImageUrl  String?
}

model Page {
  id                Int      @id @default(autoincrement())
  title             String
  slug              String   @unique
  content           String   @db.Text
  date              DateTime @default(now())
  status            String   @default("publish")
  featuredImageUrl  String?
}

model Order {
  id             String   @id @default(uuid())
  stripeSession  String   @unique
  email          String
  customerName   String?
  customerPhone  String?
  shippingAddress String?  @db.Text
  trackingNumber String?
  items          String   @db.Text
  total          Float
  shippingCost   Float
  shippingMethod String
  status              String   @default("attente_impression") // attente_impression | impression | emballe | expedie
  archived            Boolean  @default(false)
  relayDetails        String?  @db.Text
  pickupSlotRequested String?
  pickupSlotConfirmed String?
  pickupStatus        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Review {
  id           Int      @id @default(autoincrement())
  productId    Int?
  product      Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName String
  email        String
  rating       Int
  comment      String   @db.Text
  approved     Boolean  @default(false)
  showOnHome   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Visit {
  id        Int      @id @default(autoincrement())
  url       String
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())
}

model Printer {
  id     Int    @id @default(autoincrement())
  name   String @unique
  status String @default("Active") // Active | En veille | En panne
}

model DonationTier {
  id          String   @id @default(uuid())
  amount      Int
  title       String
  subtitle    String
  description String   @db.Text
  emoji       String
  color       String   @default("orange") // orange | blue
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model LoyaltyCard {
  id            String   @id @default(uuid())
  customerName  String?  @map("customer_name")
  customerEmail String?  @map("customer_email")
  points        Int      @default(0)
  maxPoints     Int      @default(100) @map("max_points")
  createdAt     DateTime @default(now()) @map("created_at")
  history       Json     @default("[]")

  @@map("loyalty_cards")
}

model Tombola {
  id              String    @id @default(uuid())
  title           String
  description     String    @db.Text
  image           String    @db.Text
  estimatedValue  Float     @default(85.00)
  endDate         String    @default("")
  totalCases      Int       @default(40)
  ticketPrice     Float     @default(2.00)
  status          String    @default("active") // active | ended | drawn
  reservedTickets Json      @default("[]") // Array of ticket numbers [1, 5, 12]
  winnerTicket    Int?
  winnerDrawnAt   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("tombolas")
}

model Color {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  category    String   @default("UNIS") // BICOLORS_DEGRADES | SPECIALS_TEXTURES | UNIS
  className   String?
  style       String?  @db.Text // CSS inline string or JSON
  description String?  @db.Text
  isAvailable Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("colors")
}

model TombolaTicket {
  id           String   @id @default(uuid())
  ticketNumber Int      @unique @map("ticket_number")
  buyerName    String?  @map("buyer_name")
  buyerEmail   String?  @map("buyer_email")
  buyerPhone   String?  @map("buyer_phone")
  status       String   @default("available") // available | reserved | paid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("tombola_tickets")
}


